-    """Return non-empty, trimmed lines without exact duplicates."""
+    """Return non-empty, trimmed lines with Unicode case-insensitive uniqueness."""
 
     seen: set[str] = set()
     result: list[str] = []
     for line in lines:
         value = line.strip()
