@@ -1,2 +1,10 @@
+"""Balance aggregation for normalized inventory events."""
+
+
 def aggregate(events: list):
-    return {}
+    """Sum event deltas by SKU, retaining keys whose total is zero."""
+    balances = {}
+    for event in events:
+        sku = event["sku"]
+        balances[sku] = balances.get(sku, 0) + event["delta"]
+    return balances
