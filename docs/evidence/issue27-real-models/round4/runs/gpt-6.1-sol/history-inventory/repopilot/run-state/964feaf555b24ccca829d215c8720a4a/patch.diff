index 3b5d2f96898dd84d1c525a42712d6dc6b4316ec3..2804312cd4ed960c73b4de2e56e81c48e2bf0a57 100644
--- a/src/inventory/validate.py
+++ b/src/inventory/validate.py
@@ -1,2 +1,13 @@
 def validate(events: list):
-    return []
+    valid = []
